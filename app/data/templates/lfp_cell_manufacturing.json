    },
    "derived": {
      "t_pos_cm": "cathode_thickness_um * 1e-4",
      "w_am_pos": "cathode_active_wt_pct / 100",
      "w_cb_pos": "(1 - w_am_pos) / 2",
      "w_binder_pos": "(1 - w_am_pos) / 2",
      "rho_solid_pos": "1 / (w_am_pos / rho_am_pos + w_cb_pos / rho_carbon_black + w_binder_pos / rho_pvdf)",
      "coat_pos_g_cm2": "t_pos_cm * (1 - porosity) * rho_solid_pos",
      "am_pos_g_cm2": "coat_pos_g_cm2 * w_am_pos",
      "cap_pos_mah_cm2": "am_pos_g_cm2 * q_pos_mah_g",
      "am_neg_g_cm2": "cap_pos_mah_cm2 * np_ratio / q_neg_mah_g",
      "coat_neg_g_cm2": "am_neg_g_cm2 / w_am_neg",
      "rho_solid_neg": "1 / (w_am_neg / rho_graphite + w_cb_neg / rho_carbon_black + w_binder_neg / rho_aqueous_binder)",
      "t_neg_cm": "coat_neg_g_cm2 / ((1 - porosity) * rho_solid_neg)",
      "anode_thickness_um": "t_neg_cm * 1e4",
      "al_g_cm2": "al_foil_um * 1e-4 / 2 * rho_al",
      "cu_g_cm2": "cu_foil_um * 1e-4 / 2 * rho_cu",
      "sep_g_cm2": "separator_um * 1e-4 * (1 - separator_porosity) * rho_separator_polymer",
      "electrolyte_g_cm2": "(t_pos_cm * porosity + t_neg_cm * porosity + separator_um * 1e-4 * separator_porosity) * rho_electrolyte",
      "unit_g_cm2": "coat_pos_g_cm2 + coat_neg_g_cm2 + al_g_cm2 + cu_g_cm2 + sep_g_cm2 + electrolyte_g_cm2",
      "area_cm2": "1000 * (cell_mass_kg - hardware_kg) / unit_g_cm2",
      "am_pos_kg": "area_cm2 * am_pos_g_cm2 / 1000",
      "cb_pos_kg": "area_cm2 * coat_pos_g_cm2 * w_cb_pos / 1000",
      "binder_pos_kg": "area_cm2 * coat_pos_g_cm2 * w_binder_pos / 1000",
      "coat_pos_kg": "area_cm2 * coat_pos_g_cm2 / 1000",
      "al_foil_kg": "area_cm2 * al_g_cm2 / 1000",
      "cathode_kg": "coat_pos_kg + al_foil_kg",
      "am_neg_kg": "area_cm2 * am_neg_g_cm2 / 1000",
      "cb_neg_kg": "area_cm2 * coat_neg_g_cm2 * w_cb_neg / 1000",
      "binder_neg_kg": "area_cm2 * coat_neg_g_cm2 * w_binder_neg / 1000",
      "coat_neg_kg": "area_cm2 * coat_neg_g_cm2 / 1000",
      "cu_foil_kg": "area_cm2 * cu_g_cm2 / 1000",
      "anode_kg": "coat_neg_kg + cu_foil_kg",
      "electrolyte_kg": "area_cm2 * electrolyte_g_cm2 / 1000",
      "separator_kg": "area_cm2 * sep_g_cm2 / 1000",
      "specific_energy_wh_kg": "area_cm2 * cap_pos_mah_cm2 / 1000 * ocv_v / cell_mass_kg",
      "q_C001_lithium_iron_phosphate": "am_pos_kg",
      "q_C001_al_collector_foil": "al_foil_kg",
      "q_C001_carbon_black": "cb_pos_kg",
